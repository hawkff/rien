{
  "name": "rien",
  "desktopName": "io.github.hawkff.rien",
  "productName": "Rien",
  "version": "3.15.1",
  "description": "Rien Desktop App - including custom plugins",
  "main": "./dist/main/index.js",
  "type": "module",
  "license": "MIT",
  "repository": "hawkff/rien",
  "author": {
    "name": "th-ch",
    "email": "th-ch@users.noreply.github.com",
    "url": "https://github.com/pear-devs/pear-desktop"
  },
  "scripts": {
    "postinstall": "install-electron",
    "test": "playwright test",
    "test:debug": "DEBUG='pw:*,-pw:test:protocol' playwright test",
    "build": "electron-vite build && bun run build:native && bun run build:exits",
    "build:native": "bun native/build.ts",
    "build:exits": "bun build src/proxy-exits/editor.ts --outdir dist/exits --target browser --format iife --minify && cp src/proxy-exits/index.html src/proxy-exits/preload.cjs dist/exits/",
    "vite:inspect": "bun run clean && electron-vite build --mode development && serve .vite-inspect",
    "start": "electron-vite preview",
    "start:debug": "ELECTRON_ENABLE_LOGGING=1 bun run start",
    "dev": "bun run build:native && bun run build:exits && NODE_ENV=development NODE_OPTIONS=--enable-source-maps electron-vite dev --watch",
    "dev:renderer": "bun run build:native && bun run build:exits && NODE_ENV=development NODE_OPTIONS=--enable-source-maps electron-vite dev",
    "dev:debug": "ELECTRON_ENABLE_LOGGING=1 bun run dev",
    "clean": "rm -rf dist pack .vite-inspect",
    "dist": "bun run clean && bun run build && electron-builder --mac --linux -p never",
    "dist:linux": "bun run clean && bun run build && electron-builder --linux -p never",
    "dist:linux:deb-arm64": "bun run clean && bun run build && electron-builder --linux deb:arm64 -p never",
    "dist:linux:rpm-arm64": "bun run clean && bun run build && electron-builder --linux rpm:arm64 -p never",
    "dist:mac": "bun run clean && bun run build && electron-builder --mac dmg:arm64 -p never",
    "lint": "oxlint --type-aware src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "changelog": "bunx auto-changelog",
    "release:linux": "bun run clean && bun run build && electron-builder --linux -p always -c.snap.publish=github",
    "release:mac": "bun run clean && bun run build && electron-builder --mac -p always",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dehoist/romanize-thai": "1.0.0",
    "@floating-ui/dom": "1.8.0",
    "@foobar404/wave": "2.0.5",
    "@ghostery/adblocker-electron": "2.20.3",
    "@ghostery/adblocker-electron-preload": "2.20.3",
    "@hono/node-server": "2.1.6",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "@indic-transliteration/sanscript": "1.3.3",
    "@jellybrick/electron-better-web-request": "2.0.0",
    "@jellybrick/mpris-service": "2.2.4",
    "@mdui/icons": "1.0.4",
    "@replit/codemirror-vim": "6.4.0",
    "@skyra/jaro-winkler": "1.1.1",
    "@xhayper/discord-rpc": "1.5.1",
    "async-mutex": "0.5.0",
    "bgutils-js": "4.0.3",
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "3.0.0-beta.4",
    "chinese-conv": "4.0.0",
    "color": "5.0.3",
    "conf": "16.0.0",
    "custom-electron-prompt": "1.6.1",
    "deepmerge-ts": "8.0.2",
    "electron-debug": "5.0.0",
    "electron-is": "3.0.0",
    "electron-localshortcut": "3.2.1",
    "electron-store": "12.0.0",
    "electron-unhandled": "6.0.0",
    "es-hangul": "2.4.0",
    "fast-average-color": "9.6.0",
    "fast-equals": "6.2.2",
    "fflate": "0.8.3",
    "filenamify": "7.0.3",
    "hanja": "1.1.5",
    "happy-dom": "21.0.4",
    "hono": "4.13.17",
    "howler": "2.2.4",
    "i18next": "27.0.1",
    "keyboardevent-from-electron-accelerator": "2.0.0",
    "keyboardevents-areequal": "0.2.2",
    "mdui": "2.1.5",
    "node-id3": "0.2.9",
    "peerjs": "1.5.5",
    "pinyin-pro": "3.29.5",
    "semver": "7.8.6",
    "serve": "14.2.7",
    "socks": "2.8.10",
    "solid-element": "1.9.2",
    "solid-floating-ui": "1.0.1",
    "solid-js": "1.9.18",
