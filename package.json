    "solid-transition-group": "0.3.0",
    "virtua": "0.54.2",
    "vudio": "2.1.1",
    "youtubei.js": "18.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@malept/flatpak-bundler": "0.4.0",
    "@playwright/test": "1.65.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/electron-localshortcut": "3.1.3",
    "@types/howler": "2.2.13",
    "@types/semver": "7.8.0",
    "@types/trusted-types": "2.0.7",
    "@types/ws": "8.18.2",
    "bufferutil": "4.2.0",
    "builtin-modules": "5.5.0",
    "discord-api-types": "0.38.58",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-solid": "0.19.0",
    "glob": "14.0.4",
    "node-gyp": "13.1.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2",
    "utf-8-validate": "6.0.6",
    "vite": "8.3.7",
    "vite-plugin-inspect": "12.1.0",
    "vite-plugin-resolve": "2.5.2",
    "vite-plugin-solid": "2.11.15",
